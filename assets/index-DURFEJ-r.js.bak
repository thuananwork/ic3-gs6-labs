"https://i.pinimg.com/236x/c8/64/a6/c864a6f82646ea6b2c5a0c364a2fa9ad.jpg","https://i.pinimg.com/236x/86/08/0d/86080d68a285b39466c43df84b32785b.jpg","https://i.pinimg.com/236x/33/94/33/33943318ad89ab6c2b93d2d94348b8a8.jpg","https://i.pinimg.com/236x/2b/ba/5f/2bba5f56fad4283e883223b436518dc1.jpg","https://i.pinimg.com/236x/71/f0/6f/71f06f40c939ac4a9c567857a16c29b9.jpg","https://i.pinimg.com/236x/47/55/01/475501eea99faf8058ab79bb086767ce.jpg","https://i.pinimg.com/236x/57/10/9b/57109b786e04c3917603074aa382909d.jpg","https://i.pinimg.com/236x/46/1f/72/461f7241413a309f22e779e215e15e60.jpg","https://i.pinimg.com/236x/06/d7/cd/06d7cd44035494c0fb342c8e9cb9389d.jpg","https://i.pinimg.com/236x/7f/04/33/7f04333dae833d0869ee7c5e9c7fbec8.jpg","https://i.pinimg.com/236x/d0/bd/26/d0bd26ec0d377e61bfffa08b95622e09.jpg","https://i.pinimg.com/236x/9d/60/3d/9d603d181e14b189a9a7460392bfc191.jpg","https://i.pinimg.com/236x/52/d2/e9/52d2e9dca37e739cf272fdf277591390.jpg","https://i.pinimg.com/236x/e1/40/0e/e1400e094aa03a4b6c4c5e0f6b50d9f7.jpg","https://i.pinimg.com/236x/cd/30/43/cd3043c2c75ad7c25f9cd5ba87b706aa.jpg","https://i.pinimg.com/236x/ef/73/d4/ef73d49d4961d3e076feb86e88d5dc7c.jpg","https://i.pinimg.com/236x/0c/42/0b/0c420bf9835676f1633a7e4b87259421.jpg","https://i.pinimg.com/236x/77/7f/ff/777fff435fb6ec5bd4bf3a7f66501a6a.jpg","https://i.pinimg.com/236x/ea/cd/8f/eacd8f51b374d43713fda54cf5679bc8.jpg","https://i.pinimg.com/236x/e7/c3/4e/e7c34ec4157c4e0551a652eaafc2cc64.jpg","https://i.pinimg.com/236x/8b/ac/82/8bac826528b74834e41429fc5f4c2664.jpg","https://i.pinimg.com/236x/59/b1/35/59b1351e78adf1eb9f67cd5bf4116902.jpg","https://i.pinimg.com/236x/f7/81/4c/f7814ce174c64da0de63a4b1b012ebcb.jpg"],extraMemeTrolls=["Đề thi vừa đọc tên em đã tự lưu bản sao.","Em làm bài như đang chọn skin trong game.","Não em vừa bật chế độ 'Để mai tính'.","Đáp án đúng đứng đó từ đầu, chỉ là em không thích.","Thầy xem bài em xong xin thêm giờ giải lao.","Con chuột click mà còn ngại giùm em.","Em vừa chứng minh đoán mò cũng cần kỹ năng.","Đề IC3 không hề khó, chỉ là em thích thử thách.","Não em chắc còn đang ở bãi giữ xe.","Điểm số thấy em là quay đầu bỏ chạy.","Em vừa làm bài theo phong cách 'tin vào bản thân'.","Đề thi bắt đầu nhớ mặt hơn nhớ đáp án.","Hôm nay em và logic chính thức chia tay.","Đừng lo, sai nhiều cũng là một tài năng.","Bài làm này có thể dùng làm phim hài.","Em click nhanh như đang săn sale.","Thầy tưởng em đang chọn đáp án bằng xúc xắc.","Đáp án đúng vừa đi ngang nhưng em giả vờ không thấy.","Em vừa khiến CPU nóng hơn bình thường.","Não em chắc đang xin quyền truy cập.","Bài em làm khiến cả phòng Lab có thêm niềm vui.","Đề thi đang cố giữ bình tĩnh.","Em với câu đúng cứ như hai cực nam châm cùng dấu.","Đừng trách đề dài, trách mình lười đọc.","Em vừa lập kỷ lục chọn sai liên hoàn.","Thầy đang nghi em học bằng truyền thuyết.","Bài làm của em có tính phiêu lưu rất cao.","Đáp án đúng nhìn em đầy tiếc nuối.","Não em hôm nay nghỉ phép không báo trước.","Em làm bài như đang chơi oẳn tù tì.","Đề thi nhìn em xong tự xin nghỉ phép.","Em là lý do nút Reset được phát minh.","Con chuột click còn biết đường hơn em.","Google cũng từ chối bình luận.","Đáp án đúng chạy mất dép khi thấy em.","Đừng nhìn bạn nữa, bạn cũng đang đoán.","Em làm bài như đang mở hòm kho báu.","Thầy chưa khóc, nhưng cũng gần rồi.","Nếu tự tin có điểm thì em thủ khoa lâu rồi.","Bài làm này mang tính giải trí rất cao.","Windows vừa hiện: 'Ủa thiệt luôn hả?'","Ctrl + Z cũng cứu không nổi.","Đừng bấm nữa, tội cái máy.","Câu này em làm rất tốt... trong tưởng tượng.","Đề IC3 không khó, chỉ không hợp với em.","Máy tính vừa xin đổi chủ.","Thầy xem xong tăng thêm một nếp nhăn.","Đề thi cũng có lòng tự trọng nha em.","Em vừa tạo ra đáp án thứ năm.","Không ai hoàn hảo... nhưng em hơi quá.","Làm bài như quay xổ số.","Đừng lo, còn thi lại mà.","Thầy gọi đây là nghệ thuật né đáp án đúng.","Em và đáp án đúng như hai người xa lạ.","Làm sai cũng phải có phong cách như em.","Bài này không khó, em tự làm khó mình thôi.","Đề thi đang cân nhắc kiện em.","Camera phòng Lab đã ghi lại tất cả.","Con chuột vừa click vừa thở dài.","Đừng cười, điểm chưa có đâu.","Não em đang đi nghỉ dưỡng.","Hôm nay kiến thức xin phép vắng mặt.","Em làm bài bằng niềm tin mãnh liệt.","Crush còn dễ hiểu hơn bài làm của em.","Đề thi không biết nên chấm hay nên cười.","Em vừa speedrun xuống đáy bảng điểm.","Đừng trách đề, trách Wi-Fi của bộ não.","Não buffering từ câu số một.","Đọc đề xong em quyết định... đoán.","Đáp án A cảm thấy bị lợi dụng.","Bài làm này có mùi tâm linh.","Em đang chơi chế độ Hardcore à?","Làm bài kiểu này chỉ có thần tài cứu.","Thầy tưởng em đang viết fanfic.","Đây là bài thi chứ không phải content.","Em vừa làm AI mất niềm tin vào nhân loại.","Thầy đọc xong phải uống thêm cà phê.","Đề thi cũng biết tổn thương.","Bài em làm khiến máy chấm lag 3 giây.","Đừng nhìn đồng hồ, nó cũng chịu.","Em với điểm cao chưa có duyên.","Thần may mắn cũng bó tay.","Hôm nay em chọn bạo lực với điểm số.","Đáp án đúng né em còn nhanh hơn deadline.","Não em đang cập nhật... 1%.","Bài làm mang đậm dấu ấn cá nhân.","Chỉ có em mới nghĩ ra đáp án này.","Máy tính vừa thở dài bằng quạt tản nhiệt.","Em vừa unlock thành tích: Sai đầy sáng tạo.","Đừng nộp vội, để đề thở chút.","Hôm nay em là content của phòng Lab.","Em học theo phương pháp 'để mai'.","Thầy nhìn em rồi nhìn trần nhà.","Điểm đang trên đường tới... nhưng quay xe.","Em chọn đáp án bằng trái tim.","Bài làm này truyền cảm hứng... học lại.","Đề IC3 cũng phải gọi em bằng tiền bối.","Thầy không giận, Thầy chỉ bất lực.","Con trỏ chuột cũng click trong vô vọng.","Bài làm này đáng được đóng khung.","Em vừa đánh bại chính mình... theo hướng xấu.","Não em vừa bật chế độ máy bay.","Đề thi muốn block em.","Em đang test độ kiên nhẫn của Thầy.","Google đọc xong cũng xóa lịch sử.","Thầy xem bài em như xem phim hài.","Đừng sợ sai, vì em đã quen rồi.","Em vừa khiến Ctrl+C cũng thấy mệt.","Đề thi đang cân nhắc đổi nghề.","Nếu sai là nghề thì em là chuyên gia.","Bài làm này có plot twist liên tục.","Máy chấm bài xin nghỉ giữa chừng.","Đừng lo, ai rồi cũng từng sai... nhưng không nhiều vậy.","Em vừa tạo bug ngoài đời thật.","Thầy tưởng em đang troll.","Bài em làm khiến AI xin nghỉ việc.","Em với kiến thức đang chiến tranh lạnh.","Đề thi chỉ biết cười trừ.","Não em đang ở server khác.","Làm bài kiểu này rất... có cá tính.","Thầy đang cố tìm logic.","Đáp án đúng vừa unfollow em.","Em khiến phòng Lab có thêm tiếng cười.","Đừng quay màn hình, quay đầu lại học đi.","Em vừa cosplay học bá thất bại.","Điểm số nhìn em rồi bỏ chạy.","Thầy tưởng em đang làm khảo sát.","Bài làm này xứng đáng vào viện bảo tàng.","Não em vừa báo 'Out of Service'.","Đề thi xin phép không quen em.","Em vừa biến câu dễ thành câu khó.","Xin chúc mừng! Em đã làm cả phòng cười."];function generate500Trolls(){const a=[],n=["Nhìn góc nghiêng tưởng Thủ Khoa, nhìn góc thẳng hóa ra chú hề!","Phát hiện 0% thần thái thủ khoa và 100% sự thích làm màu!","Ghi nhận sóng não trắng xóa như tờ giấy nháp chưa viết chữ nào!","Tốc độ bấm nút troll: 100 lần/phút. Tốc độ làm bài Lab: 2 câu/tiếng!","Khuôn mặt này rất ăn ảnh, nhưng đề thi IC3 lại không chấm điểm nhan sắc!","Máy quét báo cáo: Da mặt dày 10cm vì chưa làm bài vẫn tự tin bấm nút!","Thần thái rất tự tin, nhưng kiến thức tin học thì nằm ở mức âm!","Sóng não đang phát ra tần số của một Chú Hề Ưu Tú phòng Lab!","Đẹp trai/đẹp gái thế này mà đi thi lại IC3 thì phí quá, đi học bài đi!","Xác suất đỗ IC3 của em hiện tại thấp hơn cả cơ hội Crush nhắn tin lại!"],i=["chưa học xong bài Lab 1","đang giả vờ chăm chỉ","bấm lụi cả bài thi","quên sạch phím tắt Windows","đang ngồi mơ về Crush","chưa biết bấm Ctrl+C","đang tìm cách gian lận","ngồi ngủ gật trong giờ","đang cầu nguyện thần may mắn","thích làm màu hơn làm bài"],l=["sẽ được Thầy gọi lên bảng kiểm tra đầu giờ ngày mai!","chắc chắn sẽ nhận vé vàng thi lại K68!","nên chuẩn bị sẵn tiền đóng tiền thi lại môn IC3!","sẽ bị máy tính tự động nộp bài 0 điểm lên máy Thầy!","thắp 3 nén hương cũng không cứu nổi điểm thi!","nên quay lại làm lại bài Lab 2 gấp!","được vũ trụ gửi tín hiệu khuyên nên cất ngay bộ mặt này đi!","sẽ bị cả phòng Lab ngoảnh lại vỗ tay tuyên dương chú hề!","nên tự giác tắt màn hình và mở tài liệu ra đọc ngay!","chỉ có thể trông chờ vào phép thuật Winx mới đỗ nổi!"];["Phân tích bộ nhớ: 99% chứa hình bóng Crush, 1% là nhớ phím tắt Ctrl + C!","Trình độ Windows của em hiện tại chỉ dừng ở việc biết bấm nút Tắt Máy!","Đề thi IC3 không khó, cái khó là em không nhớ phím nào với phím nào!","Em có biết Ctrl + Z là quay lại không? Nhưng trốn học thì không Ctrl + Z được đâu!","Hỏi thật: Em đến phòng Lab để học hay để bấm nút soi nhan sắc vậy?","Với lượng kiến thức này, đi thi IC3 chắc chỉ đỗ... đỗ thừa tại đề khó!","Quẻ bói hôm nay: Chọn C hay D cũng đều sai, chỉ có làm Lab mới đúng!","Chúc mừng! Bạn quay trúng lá quẻ: 'Hôm nay thi thử ăn ngay con 0'!","Bấm nữa là máy tính tự động phát loa thông báo cả phòng Lab cùng nghe đấy!","Rủ đứa ngồi bên cạnh bấm cùng đi, để hai đứa cùng bị quê cho có đôi!","Chúc mừng bạn là chú hề thứ 1.000 bấm vào nút này trong ngày hôm nay! 🤡","Lần sau muốn khè bạn bè thì hãy làm xong 25 bài Lab rồi hẵng bấm nhé!","Thay vì ngồi bấm nút này, hãy quay sang chỉ bài cho bạn bên cạnh!","Nhìn em rất giống thủ khoa... của khóa thi lại năm sau!","Đừng bấm nữa, nút này sắp gãy vì sự tò mò của em rồi đấy!","Màn hình giả lập: Đang tự động gửi bảng điểm về cho Phụ Huynh... 99%!","Cảnh báo: Thầy giáo đang đứng sau lưng soi màn hình của em kìa!","Gõ phím 2 ngón với tốc độ Rùa bò mà tự tin bấm soi thần thái!","Tốc độ đập bàn phím của em mà dùng làm bài thì đã đỗ IC3 từ kiếp nào!","Quét IQ: Kết quả trả về vô cực nhưng dùng sai mục đích hoàn toàn!"].forEach(d=>a.push(d)),extraMemeTrolls.forEach(d=>a.push(d));for(let d=0;d<n.length;d++)for(let m=0;m<i.length;m++)for(let u=0;u<l.length;u++)a.length<500&&a.push(`Phát hiện học sinh ${i[m]}: ${n[d]} Dự báo em ${l[u]}`);return a}const ALL_TROLLS=generate500Trolls();function TrollScanner