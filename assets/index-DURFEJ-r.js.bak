i hát cho mục đích "quảng cáo sản phẩm thương mại" của cửa hàng, trực tiếp vi phạm điều kiện NC (Non-Commercial).'},{id:"1b",text:"Vi phạm bản quyền, vì mục đích quảng cáo bán giày là hoạt động thương mại kiếm tiền, vi phạm điều khoản NC.",isCorrect:!0,explanation:"Hoàn toàn chính xác! Giấy phép chứa điều khoản NC nghiêm cấm dùng tác phẩm vào các hoạt động tạo ra lợi nhuận thương mại, kể cả quảng cáo sản phẩm."},{id:"1c",text:"Đúng, vì đây chỉ là video ngắn đăng trên mạng xã hội chứ không bán trực tiếp bản nhạc.",isCorrect:!1,explanation:"Sai! Quảng cáo để bán một sản phẩm khác vẫn được tính là hoạt động thương mại."}],insight:"Điều khoản NC (Phi thương mại) cấm tuyệt đối việc sử dụng tác phẩm cho bất kỳ mục đích nào hướng tới lợi ích thương mại hoặc tiền tệ, bao gồm cả quảng bá sản phẩm, làm nhạc nền cho video kinh doanh."},{id:2,title:"Tình huống 2: Thiết kế cẩm nang sửa đổi từ tài liệu gốc",context:"An tìm thấy một tài liệu hướng dẫn học tin học văn phòng cực hay được tác giả chia sẻ với giấy phép CC BY-ND. An đã cắt bớt một số chương dài dòng, dịch nghĩa sang tiếng Việt dễ hiểu hơn, biên tập lại thành một cuốn Cẩm nang tóm tắt tiện dụng và chia sẻ miễn phí cho toàn bộ lớp học của mình.",license:"CC BY-ND",licenseDetails:"Yêu cầu ghi nhận công trạng tác giả (BY) nhưng tuyệt đối không cho phép tạo tác phẩm phái sinh/chỉnh sửa (ND).",question:"Hành vi chỉnh sửa và biên dịch tài liệu của An là đúng hay vi phạm?",options:[{id:"2a",text:"Đúng, vì An chia sẻ miễn phí cho lớp học của mình chứ không dùng để bán kiếm tiền.",isCorrect:!1,explanation:"Sai! Mặc dù An chia sẻ miễn phí, nhưng hành vi cắt bớt, dịch nghĩa, chỉnh sửa nội dung đã tạo ra tác phẩm phái sinh, trực tiếp vi phạm điều khoản ND (No Derivatives)."},{id:"2b",text:"Vi phạm bản quyền, vì giấy phép ND nghiêm cấm mọi hình thức chỉnh sửa, cắt xén, dịch thuật hoặc thay đổi nguyên bản tác phẩm.",isCorrect:!0,explanation:"Hoàn toàn chính xác! Điều kiện ND yêu cầu giữ nguyên vẹn 100% nội dung gốc. Bất kỳ sự thay đổi, rút gọn hay dịch thuật nào đều cấu thành hành vi vi phạm."},{id:"2c",text:"Đúng, vì dịch thuật và tóm tắt giúp tác phẩm lan tỏa tốt hơn đến học sinh.",isCorrect:!1,explanation:"Sai! Dù mục đích tốt, nhưng nếu không được sự đồng ý trực tiếp ngoài giấy phép của tác giả, việc tự ý dịch thuật tác phẩm CC BY-ND là vi phạm."}],insight:"Điều khoản ND (Không phái sinh) bắt buộc người dùng phải phân phối tác phẩm ở dạng nguyên bản 100%. Mọi hành vi cắt ghép, thay đổi nội dung, phối lại (remix), hoặc dịch sang ngôn ngữ khác đều bị cấm."},{id:3,title:"Tình huống 3: Lựa chọn giấy phép để bảo vệ quyền tác giả tối đa",context:"Hoa là một họa sĩ vẽ tranh kỹ thuật số. Cô muốn chia sẻ bộ tranh của mình lên mạng xã hội để mọi người chiêm ngưỡng và chia sẻ. Tuy nhiên, cô muốn ngăn chặn người khác lấy tranh của mình đem đi bán in áo thun thương mại, đồng thời yêu cầu nếu có ai đó phối lại tranh (remix) thì bắt buộc họ phải chia sẻ tác phẩm mới đó với giấy phép tự do giống cô.",license:"Tìm kiếm giấy phép phù hợp",licenseDetails:"Cần bảo vệ chống thương mại hóa tác phẩm và bắt buộc tính kế thừa giấy phép.",question:"Hoa nên chọn tổ hợp giấy phép Creative Commons nào dưới đây?",options:[{id:"3a",text:"CC BY-NC-ND (Ghi nhận công trạng - Phi thương mại - Không phái sinh)",isCorrect:!1,explanation:"Chưa chính xác! Hoa cho phép mọi người phối lại tranh (remix), nhưng điều khoản ND sẽ cấm hoàn toàn việc chỉnh sửa, phối lại này."},{id:"3b",text:"CC BY-NC-SA (Ghi nhận công trạng - Phi thương mại - Chia sẻ tương tự)",isCorrect:!0,explanation:"Tuyệt vời! BY yêu cầu ghi công cô, NC ngăn chặn người khác thương mại hóa (như in áo bán), và SA bắt buộc người phối lại tranh phải phát hành tác phẩm phái sinh đó với giấy phép tự do giống của Hoa."},{id:"3c",text:"CC BY-SA (Ghi nhận công trạng - Chia sẻ tương tự)",isCorrect:!1,explanation:"Chưa chính xác! Giấy phép này cho phép người khác dùng tranh của Hoa để kinh doanh thương mại (vì thiếu điều khoản NC), điều mà Hoa không muốn."}],insight:"Giấy phép CC BY-NC-SA là sự kết hợp hoàn hảo để bảo vệ quyền lợi kinh tế của tác giả (NC) và đảm bảo tính chất mở của cộng đồng sáng tạo bằng cách bắt buộc chia sẻ tương tự (SA)."},{id:4,title:"Tình huống 4: Tuyên bố miễn trừ bản quyền hoàn toàn (CC0)",context:"Học viện Khoa học Công nghệ muốn xuất bản một bộ cơ sở dữ liệu nghiên cứu về biến đổi khí hậu. Để tối đa hóa việc phổ biến dữ liệu phục vụ nhân loại, ban dự án quyết định từ bỏ mọi quyền tác giả trên toàn cầu, cho phép mọi người sử dụng, khai thác, thương mại hóa hoàn toàn tự do mà không cần bất kỳ điều kiện gì, thậm chí không bắt buộc phải ghi công.",license:"Public Domain / Không ràng buộc",licenseDetails:"Tự do hoàn toàn không giới hạn quyền sử dụng.",question:"Nhãn bản quyền hoặc giấy phép nào mô tả chính xác nhất mong muốn này?",options:[{id:"4a",text:"CC BY (Chỉ yêu cầu ghi công tác giả)",isCorrect:!1,explanation:"Chưa chính xác! CC BY vẫn bắt buộc người sử dụng phải ghi công tác giả, trong khi dự án muốn từ bỏ hoàn toàn mọi ràng buộc, kể cả việc ghi công."},{id:"4b",text:"CC0 (Tuyên bố Miễn trừ Bản quyền Công cộng - Public Domain)",isCorrect:!0,explanation:"Hoàn toàn chính xác! CC0 (Creative Commons Zero) là công cụ hiến tặng tác phẩm vào phạm vi công cộng, từ bỏ mọi quyền lợi bản quyền trên toàn thế giới."},{id:"4c",text:"CC BY-NC (Phi thương mại và ghi công)",isCorrect:!1,explanation:"Sai! Giấy phép này giới hạn thương mại và yêu cầu ghi công, mâu thuẫn hoàn toàn với mong muốn của dự án."}],insight:"CC0 (CC Zero) không phải là một giấy phép thông thường mà là một tuyên bố hiến tặng tác phẩm cho nhân loại (Public Domain - Phạm vi công cộng). Bất cứ ai cũng có thể sử dụng tác phẩm cho bất kỳ mục đích nào mà không cần xin phép hay ghi công."}];function Lab6({onSuccess:a}){const[n,i]=reactExports.useState("builder"),[l,c]=reactExports.useState(""),[d,m]=reactExports.useState(!1),[u,g]=reactExports.useState(null),[p,f]=reactExports.useState({}),[b,k]=reactExports.useState({}),[N,M]=reactExports.useState(null),[y,I]=reactExports.useState(!1),[R,z]=reactExports.useState("yes"),[A,O]=reactExports.useState("yes"),[L,le]=reactExports.useState(0),[P,G]=reactExports.useState(null),[ee,ce]=reactExports.useState(!1),[V,pe]=reactExports.useState(0),[Ie,se]=reactExports.useState(!1),_=(()=>{let v="CC BY",K="Ghi nhận công trạng",te=["BY"],je=["Ghi danh & dẫn nguồn tác giả gốc bắt buộc trong mọi trường hợp sử dụng."];return A==="no"&&(v+="-NC",K+=" - Phi thương mại",te.push("NC"),je.push("Cấm tuyệt đối mọi hình thức sử dụng thương mại, kiếm tiền từ tác phẩm.")),R==="no"?(v+="-ND",K+=" - Không phái sinh",te.push("ND"),je.push("Không cho phép bất kỳ sự chỉnh sửa, cắt ghép, dịch thuật nào. Phải giữ nguyên gốc.")):R==="sa"?(v+="-SA",K+=" - Chia sẻ tương tự",te.push("SA"),je.push("Nếu tạo bản remix/chỉnh sửa, bắt buộc phải chia sẻ bản mới với giấy phép tương tự.")):je.push("Cho phép người khác chỉnh sửa, phối lại (remix) tác phẩm một cách tự do."),{code:v,title:K,icons:te,rules:je}})(),U=v=>{ee||G(v)},Z=()=>{if(!P||ee)return;const K=CASE_STUDIES[L].options.find(te=>te.id===P);K!=null&&K.isCorrect&&pe(te=>te+1),ce(!0)},be=()=>{G(null),ce(!1),L<CASE_STUDIES.length-1?le(v=>v+1):(se(!0),a())},he=()=>{le(0),G(null),ce(!1),pe(0),se(!1),m(!1)},E=v=>{v.preventDefault(),l.trim()&&m(!0)};return jsxRuntimeExports.jsxs("div",{className:"space-y-8 animate-fade-in",id:"lab-6-root",children:[jsxRuntimeExports.jsxs("div",{className:"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-900 p-5 sm:p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-xs",children:[jsxRuntimeExports.jsxs("div",{className:"text-left",children:[jsxRuntimeExports.jsx("span",{className:"text-sm sm:text-base font-semibold uppercase font-black tracking-wider text-indigo-500 bg-indigo-50 dark:bg-indigo-950/40 px-2.5 py-1 rounded-md",children:"Chủ Đề IC3 GS6: Giấy phép Creative Commons (CC)"}),jsxRuntimeExports.jsx("h4",{className:"font-extrabold text-slate-900 dark:text-whit